{
  "name": "inventory-management",
  "version": "1.0.0",
  "description": "Company-wise inventory management and invoicing system",
  "scripts": {
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "seed": "npm run seed --prefix backend",
    "dev:api": "npm run dev --prefix backend",
    "dev:client": "npm run dev --prefix frontend",
    "dev": "concurrently --names \"api,web\" --prefix-colors \"blue,magenta\" \"npm:dev:api\" \"npm:dev:client\"",
    "build": "npm run build --prefix frontend",
    "start": "npm start --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
