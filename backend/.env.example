# Copy this file to `backend/.env` and fill in real values.
# `.env` is gitignored — never commit actual credentials.

# "development" or "production".
# In production the app refuses to boot without a real JWT_SECRET, and
# session cookies are marked Secure (HTTPS only).
NODE_ENV=development

# Port the Express API listens on. The Vite dev server proxies /api here.
PORT=3000

# Postgres connection string.
# Neon: Dashboard → your project → Connection Details → copy the URI.
#
# Prefer sslmode=verify-full. pg currently treats sslmode=require as an alias
# for verify-full anyway, but says so via a deprecation warning; being explicit
# silences it and keeps the same behaviour in pg v9+.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full&channel_binding=require

# Secret used to sign session cookies. Generate a unique one per install:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
