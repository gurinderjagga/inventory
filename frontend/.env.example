# Copy to `frontend/.env` for local overrides. Vite only exposes variables
# prefixed with VITE_ to client code.

# Base URL of the API when it is deployed on its own domain, e.g.
#   VITE_API_URL=https://inventory-backend.vercel.app
#
# Leave EMPTY for local development: the Vite dev server proxies /api to
# localhost:3000, so relative paths are correct and no CORS is involved.
#
# NOTE: Vite inlines this at build time. Changing it in Vercel requires a
# redeploy of the frontend — restarting is not enough.
VITE_API_URL=
